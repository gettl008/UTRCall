manifest {
    name            = 'utrcall'
    version         = '1.0.1'
    description     = 'Add RNA-seq-supported UTRs to an existing gene annotation (threshold walk on pooled stranded coverage)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04'
}

params {
    help            = false
    samplesheet     = null
    genome          = null
    gff             = null
    outdir          = 'results'
    out_prefix      = 'annotation'

    // alignment (FASTQ rows)
    star_index      = null
    intron_max      = 2000          // S. cerevisiae introns <= ~1 kb; raise for other species
    publish_star_index = false

    // filters
    min_mapq        = 255           // STAR unique = 255; HISAT2 unique = 60
    dedup_overlap   = true          // count overlapping mates once (samtools depth -s)
    exclude_chroms  = ''            // e.g. mitochondrial seqid (polycistronic transcripts)
    min_intron_reads = 5

    // UTR calling
    utr_limit       = 700           // ~p99 of S288C TIF-seq UTR lengths
    smooth          = 11
    floor           = 5
    min_cds_cov     = 10
    junction_frac   = 0.2
    f5              = 0.05          // used without --ref_utr (calibrated on Y55 vs S288C TIF-seq)
    f3              = 0.03
    fix_f           = false         // with --ref_utr: true = score fixed f5/f3 instead of calibrating
    ref_utr         = null          // TSV gene,utr5,utr3 (e.g. assets/s288c_tifseq_ypd_utr_lengths.tsv)
    ref_id_strip    = '^gene-'
    seed            = 1
    keep_capped     = false
    strict_gff_check = true

    // optional modules
    run_utrrnaseq   = false
    read_len        = 100
    run_salmon      = false
    salmon_k        = 31
    salmon_libtype  = 'A'
    salmon_bias     = true

    // conda environments: yml (built by Nextflow) or path to an existing env
    env_core        = "${projectDir}/envs/core.yml"
    env_augustus    = "${projectDir}/envs/augustus.yml"
    env_salmon      = "${projectDir}/envs/salmon.yml"

    // cluster
    slurm_account   = 'rdac_acct'
    slurm_queue     = 'defq'
    exclude_nodes   = 'node002'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 2
    beforeScript = 'export TMPDIR=$PWD'      // keep temp files out of node-local /tmp

    withLabel: small     { cpus = 1; memory = { 2.GB  * task.attempt }; time = { 2.h * task.attempt } }
    withLabel: small_mem { cpus = 1; memory = { 8.GB  * task.attempt }; time = { 4.h * task.attempt } }
    withLabel: calls     { cpus = 1; memory = { 12.GB * task.attempt }; time = { 4.h * task.attempt } }
    withLabel: medium    { cpus = 8; memory = { 24.GB * task.attempt }; time = { 6.h * task.attempt } }
    withLabel: coverage  { cpus = 8; memory = { 16.GB * task.attempt }; time = { 12.h * task.attempt } }
}

profiles {
    conda {
        conda.enabled = true
        process {
            conda = params.env_core
            withName: 'UTRRNASEQ'        { conda = params.env_augustus }
            withName: 'SALMON_INDEX|SALMON_QUANT' { conda = params.env_salmon }
        }
    }
    rdac {
        executor {
            name            = 'slurm'
            queueSize       = 50
            submitRateLimit = '190/60min'
        }
        process {
            queue          = params.slurm_queue
            clusterOptions = "-A ${params.slurm_account}" + (params.exclude_nodes ? " --exclude=${params.exclude_nodes}" : '')
            resourceLimits = [cpus: 32, memory: 80.GB, time: 28.d]
        }
    }
    local {
        executor.name = 'local'
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
    test {
        params {
            samplesheet = "${projectDir}/test/samplesheet.csv"
            genome      = "${projectDir}/test/data/genome.fa"
            gff         = "${projectDir}/test/data/annotation.gff3"
            ref_utr     = "${projectDir}/test/data/truth_utr_lengths.tsv"
            exclude_chroms = 'chrM'
            outdir      = 'test_results'
            out_prefix  = 'test'
            intron_max  = 5000
            min_cds_cov = 5
        }
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}

report.enabled   = true
report.file      = "${params.outdir}/pipeline_info/report.html"
report.overwrite = true
trace.enabled    = true
trace.file       = "${params.outdir}/pipeline_info/trace.txt"
trace.overwrite  = true
